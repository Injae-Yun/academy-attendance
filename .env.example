# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다.
#
#   cp .env.example .env
#   npm run secrets
#
# Apps Script 에는 .env 가 없다. 실행 중인 코드가 읽는 곳은 Script Properties 다.
# npm run secrets 는 아래 값으로 만든 한 줄을 클립보드에 담아준다.
# 그 줄을 Apps Script 편집기에 붙여 한 번 실행하면 저장이 끝난다.
# 키는 화면에도, 터미널 기록에도 남지 않는다.

# solapi 또는 aligo
PROVIDER=solapi

# --- 비밀값: Script Properties 로 들어간다 ---
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

ALIGO_API_KEY=
ALIGO_USER_ID=

# --- 비밀이 아닌 값: _출결_설정 시트에 직접 넣는다 ---
# npm run secrets 가 무엇을 어디에 넣을지 목록으로 보여준다.
SENDER=
PFID=
TEMPLATE_IN=
TEMPLATE_OUT=
